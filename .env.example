# Copy to .env (or set these in Render → Environment).

# Parent PIN for /admin (change it before deploying).
ADMIN_PIN=2468

# Port for local development.
PORT=3100

# Postgres connection string. When set, word lists, settings, stroke guides
# and the practice history all live in the database and follow you across
# machines and redeploys. Leave empty to use data/store.json + localStorage.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# PGSSL=off|require   # override the automatic SSL choice

# Optional: restore/save the config without a database (Render free plan).
# GIST_ID=
# GITHUB_TOKEN=
