{
  "name": "jk-writing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kid-friendly handwriting practice for iPad — Chinese and English/BM with stroke guides and automatic scoring.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "icons": "node scripts/make-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "test": "node --test test/*.test.js",
    "glyphs": "node scripts/make-glyphs.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "pinyin-pro": "^3.26.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12"
  }
}
